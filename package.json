{
  "name": "ocg-manager-ui",
  "private": true,
  "version": "2.6.4",
  "packageManager": "pnpm@10.29.2",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/release.mjs",
    "release:check": "node scripts/release.mjs --check",
    "test:rust": "cargo test --workspace --locked --features ocg-core/ollama-cloud-loopback-test",
    "test:tooling": "node --experimental-strip-types --test \"scripts/*.test.mjs\"",
    "test:dsh:plugin": "node --experimental-strip-types --test scripts/dsh-plugin-package.test.mjs",
    "smoke:dsh:plugin": "node scripts/dsh-application-install-smoke.mjs",
    "smoke:dsh:cli": "node scripts/dsh-headless-cli-smoke.mjs",
    "smoke:dsh:runtime": "node scripts/dsh-web-runtime-smoke.mjs",
    "test": "pnpm run test:tooling && pnpm run test:rust"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^5"
  }
}
