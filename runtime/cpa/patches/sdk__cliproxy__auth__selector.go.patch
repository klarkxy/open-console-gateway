+func sessionAffinityCacheKey(provider, primaryID, modelKey string) string {
+	if primaryID == "header:ocg-sticky-global" {
+		return provider + "::" + primaryID
+	}
+	return provider + "::" + primaryID + "::" + modelKey
+}
+
+func cachedAuthMissesModel(auths []*Auth, authID, model string) bool {
+	var cached *Auth
+	for _, auth := range auths {
+		if auth != nil && auth.ID == authID {
+			cached = auth
+			break
+		}
+	}
+	if cached == nil {
+		cached = &Auth{ID: authID}
+	}
+	return !ocgAuthSupportsModel(cached, model)
+}
+
+func ocgAuthSupportsModel(auth *Auth, model string) bool {
+	modelKey := canonicalModelKey(model)
+	if auth == nil || modelKey == "" {
+		return true
+	}
+	set := supportedModelSetForAuth(auth.ID)
+	if len(set) == 0 {
+		return false
+	}
+	_, ok := set[modelKey]
+	return ok
+}
