+func preserveOCGAuthFields(existing, incoming *Auth) {
+	if existing == nil || incoming == nil {
+		return
+	}
+	if incoming.Metadata == nil {
+		incoming.Metadata = map[string]any{}
+	}
+	if existing.Metadata != nil {
+		for _, key := range []string{"ocg_credential_id", "ocg_credential_version", "ocg_binding_id", "ocg_material_revision", "ocg_oauth"} {
+			if _, present := incoming.Metadata[key]; present {
+				continue
+			}
+			if value, ok := existing.Metadata[key]; ok {
+				incoming.Metadata[key] = value
+			}
+		}
+	}
+	if incoming.Attributes == nil {
+		incoming.Attributes = map[string]string{}
+	}
+	credentialChanged := ocgCredentialIdentityChanged(existing, incoming)
+	if credentialChanged {
+		if _, present := incoming.Attributes["ocg_model_scope"]; !present {
+			incoming.Attributes["ocg_model_scope"] = ""
+		}
+	}
+	for key, value := range existing.Attributes {
+		if _, present := incoming.Attributes[key]; present {
+			continue
+		}
+		if credentialChanged && (key == "ocg_model_scope" || key == "excluded_models") {
+			continue
+		}
+		if strings.HasPrefix(key, "ocg_") || strings.HasPrefix(key, "header:") || key == "websockets" || key == "priority" || key == "excluded_models" {
+			incoming.Attributes[key] = value
+		}
+	}
+	// A token-file priority must not replace an operator rank already stamped on the live auth.
+	if existing.Attributes[AttributeFilePriority] == "" && existing.Attributes["priority"] != "" {
+		if _, fromFile := incoming.Attributes[AttributeFilePriority]; fromFile {
+			incoming.Attributes["priority"] = existing.Attributes["priority"]
+			delete(incoming.Attributes, AttributeFilePriority)
+		}
+	}
+	refreshOCGMaterial(incoming)
+}
+
+func ocgCredentialIdentityChanged(existing, incoming *Auth) bool {
+	if existing == nil || incoming == nil || existing.Metadata == nil || incoming.Metadata == nil {
+		return false
+	}
+	inID, inOK := incoming.Metadata["ocg_credential_id"].(string)
+	exID, exOK := existing.Metadata["ocg_credential_id"].(string)
+	if inOK && exOK && strings.TrimSpace(inID) != strings.TrimSpace(exID) {
+		return true
+	}
+	inVer, inVerOK := incoming.Metadata["ocg_credential_version"].(string)
+	exVer, exVerOK := existing.Metadata["ocg_credential_version"].(string)
+	return inVerOK && exVerOK && strings.TrimSpace(inVer) != strings.TrimSpace(exVer)
+}
