{
  "$comment": "Extensible Dashboard V4 contract catalog. Add new $defs for later DTOs; do not rename or reshape existing definitions. Connection and template listings are secret-free. OnboardingCommitRequest.secretInput, CredentialRotateRequest.secretInput, and IdentityCredentialCreateRequest.secretInput are write-only.",
  "$defs": {
    "AccountAuthScheme": {
      "description": "Custom auth scheme. Wire values match V2 kebab-case.",
      "enum": [
        "bearer",
        "x-api-key"
      ],
      "type": "string"
    },
    "AccountCredentialKind": {
      "description": "Wire identity matching V2 `api_key` / `none`.",
      "enum": [
        "api_key",
        "none"
      ],
      "type": "string"
    },
    "AccountUpstreamProtocol": {
      "description": "Custom/upstream protocol. Wire values match V2 snake_case.",
      "enum": [
        "chat_completions",
        "responses",
        "messages"
      ],
      "type": "string"
    },
    "AuthState": {
      "enum": [
        "unknown",
        "valid",
        "invalid"
      ],
      "type": "string"
    },
    "AuthorityRefDto": {
      "additionalProperties": false,
      "properties": {
        "issuerOrSite": {
          "type": "string"
        },
        "tenantOrSubject": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issuerOrSite",
        "tenantOrSubject"
      ],
      "type": "object"
    },
    "AuthorizationState": {
      "description": "Local authorization projection. Unknown is not a verified success.",
      "enum": [
        "not_required",
        "missing",
        "unknown",
        "valid",
        "invalid"
      ],
      "type": "string"
    },
    "BindingDto": {
      "additionalProperties": false,
      "properties": {
        "allowedEndpointIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "allowedOrigins": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "connectionId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "modelScope": {
          "$ref": "#/$defs/ModelScope"
        },
        "routingRank": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "connectionId",
        "allowedEndpointIds",
        "allowedOrigins",
        "modelScope",
        "enabled",
        "routingRank"
      ],
      "type": "object"
    },
    "BindingPatchRequest": {
      "additionalProperties": false,
      "description": "Required process-scoped mutation precondition.\n\nBoth fields travel at the top level of every mutation request. The random\nprocess generation prevents a revision captured before restart from being\naccepted by a fresh process whose in-memory counter reused the same value.",
      "properties": {
        "allowedEndpointIds": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "allowedOrigins": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "modelScope": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModelScope"
            },
            {
              "type": "null"
            }
          ]
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expectedRevision",
        "processGeneration"
      ],
      "type": "object"
    },
    "BindingPatchResult": {
      "additionalProperties": false,
      "properties": {
        "binding": {
          "$ref": "#/$defs/BindingDto"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        }
      },
      "required": [
        "revision",
        "binding"
      ],
      "type": "object"
    },
    "CatalogModelsRemoveRequest": {
      "additionalProperties": false,
      "description": "Remove models from a persisted built-in Provider catalog snapshot.\n\nLocal-only. An official catalog refresh may add the same IDs back.",
      "properties": {
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "modelIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expectedRevision",
        "processGeneration",
        "modelIds"
      ],
      "type": "object"
    },
    "CatalogModelsRemoveResult": {
      "additionalProperties": false,
      "properties": {
        "catalogModels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "removedIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        }
      },
      "required": [
        "revision",
        "removedIds",
        "catalogModels"
      ],
      "type": "object"
    },
    "ConnectionEndpoint": {
      "additionalProperties": false,
      "properties": {
        "authScheme": {
          "$ref": "#/$defs/EndpointAuthScheme"
        },
        "connectionId": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "locked": {
          "type": "boolean"
        },
        "operation": {
          "$ref": "#/$defs/EndpointOperation"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "wireProtocol": {
          "$ref": "#/$defs/AccountUpstreamProtocol"
        }
      },
      "required": [
        "id",
        "connectionId",
        "operation",
        "wireProtocol",
        "url",
        "authScheme",
        "locked"
      ],
      "type": "object"
    },
    "ConnectionLifecycle": {
      "description": "V4 connection lifecycle, including persisted onboarding drafts.\n\nDraft is control-plane only: routing snapshots never carry it.",
      "enum": [
        "configured",
        "disabled",
        "draft"
      ],
      "type": "string"
    },
    "ConnectionList": {
      "additionalProperties": false,
      "properties": {
        "connections": {
          "items": {
            "$ref": "#/$defs/ConnectionSummary"
          },
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        }
      },
      "required": [
        "revision",
        "connections"
      ],
      "type": "object"
    },
    "ConnectionOrigin": {
      "description": "Provenance of a projected connection.",
      "enum": [
        "builtin",
        "preset",
        "custom",
        "custom_account"
      ],
      "type": "string"
    },
    "ConnectionSummary": {
      "additionalProperties": false,
      "properties": {
        "adapterKind": {
          "type": "string"
        },
        "authorization": {
          "$ref": "#/$defs/AuthorizationState"
        },
        "credentialCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "displayFamily": {
          "type": [
            "string",
            "null"
          ]
        },
        "eligibility": {
          "$ref": "#/$defs/Eligibility"
        },
        "enabledCredentialCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "endpoints": {
          "items": {
            "$ref": "#/$defs/ConnectionEndpoint"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "legacy": {
          "$ref": "#/$defs/LegacyIdentity"
        },
        "lifecycle": {
          "$ref": "#/$defs/ConnectionLifecycle"
        },
        "name": {
          "type": "string"
        },
        "offering": {
          "$ref": "#/$defs/OfferingKind"
        },
        "origin": {
          "$ref": "#/$defs/ConnectionOrigin"
        },
        "targetCount": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "targets": {
          "items": {
            "$ref": "#/$defs/ConnectionTarget"
          },
          "type": "array"
        },
        "templateRef": {
          "anyOf": [
            {
              "$ref": "#/$defs/TemplateRef"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "origin",
        "templateRef",
        "adapterKind",
        "lifecycle",
        "authorization",
        "eligibility",
        "credentialCount",
        "enabledCredentialCount",
        "targetCount",
        "endpoints",
        "targets",
        "legacy",
        "displayFamily",
        "offering"
      ],
      "type": "object"
    },
    "ConnectionTarget": {
      "additionalProperties": false,
      "properties": {
        "connectionId": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "endpointIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "publicName": {
          "type": "string"
        },
        "upstreamModelId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "connectionId",
        "publicName",
        "upstreamModelId",
        "endpointIds",
        "enabled"
      ],
      "type": "object"
    },
    "ControlRevision": {
      "additionalProperties": false,
      "description": "Live CAS token, process generation, and pricing snapshot id.",
      "properties": {
        "pricingRevision": {
          "type": "string"
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "processGeneration",
        "pricingRevision"
      ],
      "type": "object"
    },
    "CpaCatalog": {
      "additionalProperties": false,
      "properties": {
        "models": {
          "items": {
            "$ref": "#/$defs/CpaCatalogEntry"
          },
          "type": "array"
        },
        "refreshedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        },
        "sourceUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "revision",
        "models",
        "sourceUrl",
        "refreshedAt"
      ],
      "type": "object"
    },
    "CpaCatalogEntry": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "ownedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "ownedBy",
        "enabled"
      ],
      "type": "object"
    },
    "CpaCatalogUpdate": {
      "additionalProperties": false,
      "description": "Required process-scoped mutation precondition.\n\nBoth fields travel at the top level of every mutation request. The random\nprocess generation prevents a revision captured before restart from being\naccepted by a fresh process whose in-memory counter reused the same value.",
      "properties": {
        "enabledIds": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "expectedRevision",
        "processGeneration",
        "enabledIds"
      ],
      "type": "object"
    },
    "CredentialDto": {
      "additionalProperties": false,
      "properties": {
        "authState": {
          "$ref": "#/$defs/AuthState"
        },
        "authStateVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "enabled": {
          "type": "boolean"
        },
        "expiresAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "hasMaterial": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "materialKind": {
          "$ref": "#/$defs/MaterialKind"
        },
        "purpose": {
          "$ref": "#/$defs/CredentialPurpose"
        },
        "secretRef": {
          "type": "string"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "id",
        "purpose",
        "materialKind",
        "secretRef",
        "hasMaterial",
        "version",
        "enabled",
        "authState",
        "authStateVersion",
        "expiresAt"
      ],
      "type": "object"
    },
    "CredentialPurpose": {
      "enum": [
        "inference",
        "platform_observer"
      ],
      "type": "string"
    },
    "CredentialRotateRequest": {
      "additionalProperties": false,
      "description": "Required process-scoped mutation precondition.\n\nBoth fields travel at the top level of every mutation request. The random\nprocess generation prevents a revision captured before restart from being\naccepted by a fresh process whose in-memory counter reused the same value.",
      "properties": {
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "secretInput": {
          "type": "string"
        }
      },
      "required": [
        "expectedRevision",
        "processGeneration",
        "secretInput"
      ],
      "type": "object"
    },
    "CredentialRotateResult": {
      "additionalProperties": false,
      "properties": {
        "authStateVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "credentialId": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "credentialId",
        "version",
        "authStateVersion",
        "replayed"
      ],
      "type": "object"
    },
    "CredentialSummary": {
      "additionalProperties": false,
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/BindingDto"
          },
          "type": "array"
        },
        "credential": {
          "$ref": "#/$defs/CredentialDto"
        },
        "lastError": {
          "type": [
            "string",
            "null"
          ]
        },
        "legacy": {
          "$ref": "#/$defs/IdentityLegacy"
        },
        "onboardingTask": {
          "anyOf": [
            {
              "$ref": "#/$defs/OnboardingTaskDto"
            },
            {
              "type": "null"
            }
          ]
        },
        "quotaPoolId": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "quotaWindows": {
          "items": {
            "$ref": "#/$defs/QuotaWindowDto"
          },
          "type": "array"
        },
        "subject": {
          "$ref": "#/$defs/RuntimeSubjectKind"
        },
        "subscription": {
          "anyOf": [
            {
              "$ref": "#/$defs/SubscriptionDto"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "credential",
        "subject",
        "bindings",
        "quotaWindows",
        "quotaPoolId",
        "onboardingTask",
        "subscription",
        "lastError",
        "legacy"
      ],
      "type": "object"
    },
    "DeclaredRelationDto": {
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        },
        "platformAccountId": {
          "type": "string"
        }
      },
      "required": [
        "platformAccountId",
        "group"
      ],
      "type": "object"
    },
    "Eligibility": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/EligibilityReason"
        },
        "state": {
          "$ref": "#/$defs/EligibilityState"
        }
      },
      "required": [
        "state",
        "reason"
      ],
      "type": "object"
    },
    "EligibilityReason": {
      "description": "Why a connection is eligible or not. `None` is a successful Eligible row.",
      "enum": [
        "missing_credential",
        "all_credentials_disabled",
        "all_credentials_invalid",
        "cooling",
        "no_enabled_target",
        "connection_disabled",
        "none"
      ],
      "type": "string"
    },
    "EligibilityState": {
      "description": "Local attempt eligibility. Unknown authorization may still be Eligible.",
      "enum": [
        "eligible",
        "ineligible",
        "cooling"
      ],
      "type": "string"
    },
    "EndpointAuthScheme": {
      "description": "Auth advertised on a connection endpoint. `Sealed` is used for built-in\nadapters whose scheme is owned by code, not by the projected row.",
      "enum": [
        "bearer",
        "x-api-key",
        "sealed",
        "none"
      ],
      "type": "string"
    },
    "EndpointOperation": {
      "description": "Inference operation advertised by one endpoint. Mapped 1:1 from\n[`UpstreamProtocolKind`].",
      "enum": [
        "chat_create",
        "response_create",
        "message_create"
      ],
      "type": "string"
    },
    "EndpointSpec": {
      "additionalProperties": false,
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "operation": {
          "$ref": "#/$defs/EndpointOperation"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "wireProtocol": {
          "$ref": "#/$defs/AccountUpstreamProtocol"
        }
      },
      "required": [
        "operation",
        "wireProtocol",
        "url",
        "locked"
      ],
      "type": "object"
    },
    "IdentityConfidence": {
      "enum": [
        "opaque",
        "declared"
      ],
      "type": "string"
    },
    "IdentityCredentialCreateRequest": {
      "additionalProperties": false,
      "description": "Required process-scoped mutation precondition.\n\nBoth fields travel at the top level of every mutation request. The random\nprocess generation prevents a revision captured before restart from being\naccepted by a fresh process whose in-memory counter reused the same value.",
      "properties": {
        "accountLabel": {
          "type": [
            "string",
            "null"
          ]
        },
        "connectionId": {
          "type": "string"
        },
        "expectedRevision": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "operationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "processGeneration": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "quotaSharing": {
          "$ref": "#/$defs/QuotaSharing"
        },
        "secretInput": {
          "type": "string"
        }
      },
      "required": [
        "expectedRevision",
        "processGeneration",
        "connectionId",
        "secretInput"
      ],
      "type": "object"
    },
    "IdentityCredentialCreateResult": {
      "additionalProperties": false,
      "properties": {
        "accountId": {
          "type": "string"
        },
        "authStateVersion": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bindingId": {
          "type": "string"
        },
        "connectionId": {
          "type": "string"
        },
        "credentialId": {
          "type": "string"
        },
        "identityId": {
          "type": "string"
        },
        "replayed": {
          "type": "boolean"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        },
        "version": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "revision",
        "identityId",
        "credentialId",
        "bindingId",
        "accountId",
        "connectionId",
        "version",
        "authStateVersion",
        "replayed"
      ],
      "type": "object"
    },
    "IdentityLegacy": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/IdentityLegacyKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "IdentityLegacyKind": {
      "enum": [
        "account",
        "platform_account"
      ],
      "type": "string"
    },
    "IdentityList": {
      "additionalProperties": false,
      "properties": {
        "identities": {
          "items": {
            "$ref": "#/$defs/IdentitySummary"
          },
          "type": "array"
        },
        "revision": {
          "$ref": "#/$defs/ControlRevision"
        }
      },
      "required": [
        "revision",
        "identities"
      ],
      "type": "object"
    },
    "IdentitySummary": {
      "additionalProperties": false,
      "properties": {
        "credentials": {
          "items": {
            "$ref": "#/$defs/CredentialSummary"
          },
          "type": "array"
        },
        "declaredRelations": {
          "items": {
            "$ref": "#/$defs/DeclaredRelationDto"
          },
          "type": "array"
        },
        "identity": {
          "$ref": "#/$defs/UpstreamAccountDto"
        },
        "legacy": {
          "$ref": "#/$defs/IdentityLegacy"
        }
      },
      "required": [
        "identity",
        "credentials",
        "declaredRelations",
        "legacy"
      ],
      "type": "object"
    },
    "LegacyConnectionKind": {
      "description": "Pre-unification row a connection was projected from.",
      "enum": [
        "builtin_provider",
        "dynamic_provider",
        "custom_account"
      ],
      "type": "string"
    },
    "LegacyIdentity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/LegacyConnectionKind"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "type": "object"
    },
    "MaterialKind": {
      "enum": [
        "api_key",
        "external_reference"
      ],
      "type": "string"
    },
    "ModelScope": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "all",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "only",
              "type": "string"
            },
            "models": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
